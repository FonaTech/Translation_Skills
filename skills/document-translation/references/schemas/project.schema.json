{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Translation project v1",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "target_languages",
    "editions",
    "style",
    "page_size",
    "direction"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string"
    },
    "source_language": {
      "type": "string"
    },
    "target_languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
      }
    },
    "editions": {
      "const": [
        "faithful",
        "interpretive"
      ]
    },
    "style": {
      "enum": [
        "editorial",
        "accessible",
        "compact"
      ]
    },
    "page_size": {
      "enum": [
        "A4",
        "Letter"
      ]
    },
    "columns": {
      "enum": [
        1,
        2
      ]
    },
    "direction": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "ltr",
          "rtl"
        ]
      }
    },
    "author_credit": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
