{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Translation task/patch packet v1",
  "type": "object",
  "required": [
    "language",
    "items"
  ],
  "properties": {
    "language": {
      "type": "string"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "faithful",
          "interpretive"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "faithful": {
            "type": "string"
          },
          "interpretive": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
